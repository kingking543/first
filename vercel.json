{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build -- --mode vercel",
  "rewrites": [
    {
      "source": "/data/official-draws.json",
      "destination": "/api/official-draws"
    }
  ],
  "headers": [
    {
      "source": "/data/official-draws.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "functions": {
    "api/official-draws.ts": {
      "maxDuration": 30,
      "includeFiles": "src/data/official-draws.json"
    }
  }
}
